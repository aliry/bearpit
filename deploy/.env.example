# Copy to deploy/.env and fill in every value before `docker compose up`.
# Real secrets live here and nowhere else — never in a project package, never in a container image.
#
# Generate each one fresh. Do not reuse a value across two of these: they protect different things,
# and one leak should not become four.

# --- Postgres: the control plane's own database (chronicle, transcripts, private notes) ---------
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Postgres for the LiteLLM proxy (its key + spend bookkeeping) -------------------------------
#   openssl rand -hex 32
LITELLM_DB_PASSWORD=

# --- LiteLLM master key -------------------------------------------------------------------------
# The proxy's admin credential: it mints and revokes every per-agent virtual key. LiteLLM requires
# the `sk-` prefix.
#   printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# --- Realmtools secret --------------------------------------------------------------------------
# The most load-bearing value here. It is the HMAC key behind every agent's identity token, AND the
# material the sealed-submission key is derived from — so a weak value lets an agent forge another
# agent's identity or unseal a hidden move before the reveal. Minimum 32 characters; the server
# refuses to start below that.
#   openssl rand -hex 32
REALMTOOLS_SECRET=

# --- Matrix system account password -------------------------------------------------------------
# The password of the system user that owns every realm's rooms. Must stay STABLE across runs —
# changing it orphans the existing homeserver account.
#   openssl rand -hex 32
AGENTREALM_SYSTEM_PASSWORD=

# --- Keystore encryption key --------------------------------------------------------------------
# A Fernet key encrypting your BYOK provider credentials at rest in ~/.agentrealm/keystore.json.
# This one is NOT a hex string — it must be a valid Fernet key:
#   uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AGENTREALM_KEYSTORE_KEY=

# --- Control-plane database URL -----------------------------------------------------------------
# The platform runs on the HOST (Forge needs the Docker socket), so it reaches Postgres at
# localhost — while the containers in this compose file reach it as `postgres`. The built-in
# default carries the old weak password and cannot know the one you just generated, so uncomment
# this and paste POSTGRES_PASSWORD into it.
#
# Left COMMENTED, not blank, on purpose: this file is sourced with `set -a`, so an empty value
# would export an empty string and override the default with nothing at all.
# AGENTREALM_DATABASE_URL=postgresql+asyncpg://arealm:<POSTGRES_PASSWORD>@localhost:5432/agentrealm

# --- Optional -----------------------------------------------------------------------------------
# Your own Matrix localpart. Every agent is allowed to hear this user, so you can inject a message
# into a live realm (influence by message — never mid-run control). Defaults to "operator".
# AGENTREALM_OPERATOR_USER=operator
